= vite_javascript_tag 'admin_tag_form'

-# multipart: 本文中の画像（article_images[<uuid>]）を保存時に一緒に送るため
= form_with model: [:admin, article], local: true, multipart: true, id: 'admin-article-form' do |f|
  - if article.errors.any?
    .alert.alert-danger
      %ul.mb-0
        - article.errors.full_messages.each do |message|
          %li= message
  .form-group
    = f.label :title
    = f.text_field :title, class: 'form-control'
  .form-group
    = f.label :published
    = f.select :published, [['publish', true], ['draft', false]], {}, class: 'form-control'
  -# TODO: タグのリストが表示されないので調査する
  .form-group
    = f.label :tags
    = f.text_area :tags, value: article.tags.pluck(:name), placeholder: 'tag name', name: 'tags', id: 'tag-area', data: {tag: @tag_names}
  .form-group
    = f.label :text
    .row
      .col-md-6
        = f.text_area :text, id: 'admin-article-text', class: 'form-control', size: '30x30'
      .col-md-6.border
        #markdown-preview
  = f.submit nil, class: 'btn btn-primary'
