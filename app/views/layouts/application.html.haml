!!!
%html{ lang: 'ja' }
  %head
    -# NOTE: 描画前にテーマを確定させ、ライト→ダークのちらつきを防ぐ
    :javascript
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme !== 'light' && theme !== 'dark') {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();

    %script{ async: true, src: "https://www.googletagmanager.com/gtag/js?id=G-WYDMS02B2H" }

    :javascript
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-WYDMS02B2H');

    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %meta{ name: 'viewport', content: 'width=device-width, initial-scale=1' }/
    %title FujjimaBlog
    = csrf_meta_tags
    = csp_meta_tag

    -# ref) https://www.reddit.com/r/reactjs/comments/109cb1d/favicon_in_reactappvite/
    %link{ rel: "icon", type: "image/png", href: "/favicon.ico" }

    -# NOTE: Hot Module Reload 用タグ
    = vite_client_tag

    -# TODO: vite_stylesheet_tag のみ使えないので原因調査したい
    -# = vite_stylesheet_tag 'stylesheets/application.scss'
    = vite_javascript_tag 'application'
    = display_meta_tags(default_meta_tags)

  %body
    = render 'layouts/header'
    %main.main
      = yield
    = render 'layouts/footer'
